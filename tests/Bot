async def balance_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработчик команды /balans."""
    user_id = str(update.effective_user.id)
    username = update.effective_user.username or update.effective_user.first_name
    balances = load_balances()
    balance = get_user_balance(user_id, balances)
    await update.message.reply_text(f"✨ Ваш текущий баланс: **{balance}** монет.")

async def add_balance_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """
    Обработчик команды /addbalans (только для админов).
    Требует ответа на сообщение пользователя.
    Пример использования: ответьте на сообщение пользователя и введите `/addbalans 100`
    """
    sender_id = str(update.effective_user.id)
    if not is_admin(sender_id):
        await update.message.reply_text("Эта команда доступна только администраторам.")
        return

    # Проверяем, ответил ли админ на сообщение пользователя
    if not update.message.reply_to_message:
        await update.message.reply_text("Пожалуйста, ответьте на сообщение пользователя, которому хотите зачислить монеты, и введите команду `/addbalans <сумма>`.")
        return

    target_user_info = update.message.reply_to_message.from_user
    target_user_id = str(target_user_info.id)
    target_username = target_user_info.username or target_user_info.first_name

    args = context.args

    if not args or len(args) < 1:
        await update.message.reply_text("Укажите сумму для пополнения. Пример: `/addbalans 100`")
        return

    amount_str = args[0]
    try:
        amount = int(amount_str)
        if amount <= 0:
            await update.message.reply_text("Сумма должна быть положительным числом.")
            return
    except ValueError:
        await update.message.reply_text("Сумма должна быть числом.")
        return

    balances = load_balances()
    add_user_balance(target_user_id, amount, balances)
    save_balances(balances)
    logger.info(f"Admin @{update.effective_user.username} added {amount} coins to @{target_username} (ID: {target_user_id}).")

    await update.message.reply_text(f"✅ Успешно зачислено **{amount}** монет пользователю @{target_username}.")
    # Опционально: уведомить пользователя о пополнении
    try:
        await context.bot.send_message(
            chat_id=target_user_id,
            text=f"✨ Ваш баланс пополнен на **{amount}** монет администратором!"
        )
    except Exception as e:
        logger.error(f"Failed to send balance update notification to @{target_username}: {e}")


async def transfer_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """
    Обработчик команды /transfer.
    Требует ответа на сообщение пользователя.
    Пример использования: ответьте на сообщение пользователя и введите `/transfer @username 50`
    """
    sender_id = str(update.effective_user.id)
    sender_username = update.effective_user.username or update.effective_user.first_name

    # Проверяем, ответил ли пользователь на сообщение другого пользователя
    if not update.message.reply_to_message:
        await update.message.reply_text("Пожалуйста, ответьте на сообщение пользователя, которому хотите перевести монеты, и введите команду `/transfer <сумма>`.")
        return

    target_user_info = update.message.reply_to_message.from_user
    target_user_id = str(target_user_info.id)
    target_username = target_user_info.username or target_user_info.first_name

    # Нельзя переводить самому себе
    if target_user_id == sender_id:
        await update.message.reply_text("Вы не можете переводить монеты самому себе.")
        return

    args = context.args
    if not args or len(args) < 1:
        await update.message.reply_text("Укажите сумму для перевода. Пример: `/transfer 50`")
        return

    amount_str = args[0]
    try:
        amount = int(amount_str)
        if amount <= 0:
            await update.message.reply_text("Сумма должна быть положительным числом.")
            return
    except ValueError:
        await update.message.reply_text("Сумма должна быть числом.")
        return

    balances = load_balances()
    sender_balance = get_user_balance(sender_id, balances)

    # Выполняем перевод
    if subtract_user_balance(sender_id, amount, balances):
        add_user_balance(target_user_id, amount, balances)
        save_balances(balances)
        logger.info(f"User @{sender_username} transferred {amount} coins to @{target_username} (ID: {target_user_id}).")

        await update.message.reply_text(f"✅ Вы успешно перевели **{amount}** монет пользователю @{target_username}.")

        # Уведомляем получателя
        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text=f"✨ Вы получили **{amount}** монет от @{sender_username}!"
            )
        except Exception as e:
            logger.error(f"Failed to send transfer notification to @{target_username}: {e}")
    else:
        await update.message.reply_text(f"❌ У вас недостаточно монет для перевода. Ваш баланс: **{sender_balance}**.")


async def casino_menu_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработчик команды /casino."""
    keyboard = [
        [InlineKeyboardButton("🎲 Угадай число", callback_data='casino_guess_number')],
        # Добавьте другие игры сюда
        # [InlineKeyboardButton("♠️ Рулетка", callback_data='casino_roulette')],
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("🎰 Добро пожаловать в казино! Выберите игру:", reply_markup=reply_markup)

async def shop_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработчик команды /shop."""
    shop_items = load_shop_items()
    keyboard = []
    for item_key, item_data in shop_items.items():
        keyboard.append([
            InlineKeyboardButton(
                f"{item_data['name']} ({item_data['price']} монет)",
                callback_data=f'buy_{item_key}'
            )
        ])

    if not keyboard:
        await update.message.reply_text("Магазин пуст. Товары будут добавлены позже.")
        return

    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text("🛍️ **Добро пожаловать в магазин!**\n"
                                    "Выберите товар, чтобы узнать подробности или купить.",
                                    reply_markup=reply_markup)

async def button_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработчик нажатий на инлайн-кнопки."""
    query = update.callback_query
    await query.answer() # Важно ответить на callback, чтобы убрать "часики" у кнопки
    data = query.data
    user_id = str(query.from_user.id)
    username = query.from_user.username or query.from_user.first_name
    balances = load_balances()
    user_balance = get_user_balance(user_id, balances)

    # --- Обработка кнопок казино ---
    if data.startswith('casino_'):
        game_name = data[7:] # Получаем название игры (например, 'guess_number')
        if game_name == 'guess_number':
            await query.edit_message_text("🎲 **Игра: Угадай число!**\n"
                                          "Я загадаю число от 1 до 10. Укажи свою ставку и число в команде.\n"
                                          "Пример: `/guess 50 7` (ставка 50, число 7).\n"
                                          "Если угадаешь, получишь ставку x2.")
        # elif game_name == 'roulette':
        #     await query.edit_message_text("♠️ Рулетка...") # Логика для рулетки

    # --- Обработка кнопок магазина ---
    elif data.startswith('buy_'):
        item_key = data[4:] # Получаем ключ товара (например, 'moderator')
        shop_items = load_shop_items()

        if item_key in shop_items:
            item_data = shop_items[item_key]
            item_name = item_data['name']
            item_price = item_data['price']
            item_description = item_data.get('description', 'Нет описания.')

            if user_balance >= item_price:
                # Пытаемся списать средства
                if subtract_user_balance(user_id, item_price, balances):
                    save_balances(balances)
                    logger.info(f"User @{username} bought '{item_name}' for {item_price} coins.")

                    # --- Логика выдачи покупки ---
                    if item_key == 'moderator':
                        # Здесь можно добавить логику выдачи роли модератора,
                        # если бот управляет группой или есть другая система ролей.
                        # Пока просто сообщение.
                        await query.edit_message_text(
                            f"🎉 Поздравляем! Вы приобрели '{item_name}' за **{item_price}** монет. "
                            f"Ваш новый баланс: **{get_user_balance(user_id, balances)}**.\n\n"
                            f"<i>{item_description}</i>"
                        )
                    elif item_key == 'vip_role':
                         await query.edit_message_text(
                            f"👑 Поздравляем! Вы приобрели '{item_name}' за **{item_price}** монет. "
                            f"Ваш новый баланс: **{get_user_balance(user_id, balances)}**.\n\n"
                            f"<i>{item_description}</i>"
                        )
                    else:
                        # Для других товаров
                        await query.edit_message_text(
                            f"✅ Вы успешно приобрели '{item_name}' за **{item_price}** монет. "
                            f"Ваш новый баланс: **{get_user_balance(user_id, balances)}**.\n\n"
                            f"<i>{item_description}</i>"
                        )
                else:
                    # Этого не должно произойти, так как баланс был проверен
                    await query.edit_message_text("Ошибка при списании средств. Попробуйте позже.")
            else:
                await query.edit_message_text(
                    f"❌ Недостаточно монет для покупки '{item_name}'. "
                    f"Стоимость: {item_price} монет. Ваш баланс: {user_balance}."
                )
        else:
            await query.edit_message_text("Этот товар больше не доступен в магазине.")

    else:
        # Если callback data не распознана
        logger.warning(f"Received unknown callback data: {data} from user @{username}")
        await query.edit_message_text("Произошла неизвестная ошибка с кнопкой.")


async def unknown_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработчик для всех команд, которые не были распознаны."""
    await update.message.reply_text("🤔 Извините, я не понимаю эту команду. Используйте /help для списка доступных команд.")

# --- Главная функция ---

def main() -> None:
    """Запускает бота."""
    # Создаем Application
    application = Application.builder().token(config.BOT_TOKEN).build()

    # --- Регистрация обработчиков ---

    # Команды
    application.add_handler(CommandHandler("start", start_command))
    application.add_handler(CommandHandler("help", help_command))
    application.add_handler(CommandHandler("balans", balance_command))
    application.add_handler(CommandHandler("addbalans", add_balance_command))
    application.add_handler(CommandHandler("transfer", transfer_command))
    application.add_handler(CommandHandler("casino", casino_menu_command))
    application.add_handler(CommandHandler("shop", shop_command))

    # Игры казино (регистрация команды для каждой игры)
    application.add_handler(CommandHandler("guess", guess_number_start)) # Команда для игры "Угадай число"

    # Обработчик нажатий на инлайн-кнопки (для казино и магазина)
    application.add_handler(CallbackQueryHandler(button_callback))

    # Обработчик для всех остальных текстовых сообщений, которые не являются командами
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, lambda u, c: u.message.reply_text(f"Я не понимаю '{u.message.text}'. Используйте /help.")))

    # Обработчик для всех неизвестных команд
    application.add_handler(MessageHandler(filters.COMMAND, unknown_command))

    # --- Запуск бота ---
    logger.info("Bot started...")
    application.run_polling()

if __name__ == '__main__':
    main()
