)
logger = logging.getLogger(__name__)

# --- Функции для работы с данными ---

def load_balances():
    """Загружает балансы пользователей из JSON файла."""
    if os.path.exists(config.BALANCES_FILE):
        with open(config.BALANCES_FILE, 'r', encoding='utf-8') as f:
            try:
                return json.load(f)
            except json.JSONDecodeError:
                return {} # Если файл пуст или поврежден
    return {} # Если файла нет

def save_balances(balances):
    """Сохраняет балансы пользователей в JSON файл."""
    with open(config.BALANCES_FILE, 'w', encoding='utf-8') as f:
        json.dump(balances, f, indent=4)

def load_admin_ids():
    """Загружает список ID администраторов."""
    if os.path.exists(config.ADMIN_IDS_FILE):
        with open(config.ADMIN_IDS_FILE, 'r', encoding='utf-8') as f:
            try:
                return json.load(f)
            except json.JSONDecodeError:
                return []
    return [] # Если файла нет

def load_shop_items():
    """Загружает товары из магазина."""
    if os.path.exists(config.SHOP_ITEMS_FILE):
        with open(config.SHOP_ITEMS_FILE, 'r', encoding='utf-8') as f:
            try:
                return json.load(f)
            except json.JSONDecodeError:
                return {}
    return {} # Если файла нет

# --- Вспомогательные функции для балансов ---

def get_user_balance(user_id: str, balances: dict) -> int:
    """Получает баланс пользователя, возвращает 0, если пользователя нет."""
    return balances.get(str(user_id), 0)

def add_user_balance(user_id: str, amount: int, balances: dict):
    """Добавляет монеты пользователю."""
    user_id_str = str(user_id)
    balances[user_id_str] = get_user_balance(user_id_str, balances) + amount

def subtract_user_balance(user_id: str, amount: int, balances: dict) -> bool:
    """
    Вычитает монеты у пользователя.
    Возвращает True, если успешно, False если недостаточно средств.
    """
    user_id_str = str(user_id)
    current_balance = get_user_balance(user_id_str, balances)
    if current_balance >= amount:
        balances[user_id_str] = current_balance - amount
        return True
    return False

# --- Проверка, является ли пользователь админом ---

def is_admin(user_id: str) -> bool:
    """Проверяет, является ли пользователь админом."""
    admin_ids = load_admin_ids()
    return str(user_id) in map(str, admin_ids) # Сравниваем строки

# --- Обработчики команд ---

async def start_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработчик команды /start."""
    user_id = str(update.effective_user.id)
    username = update.effective_user.username or update.effective_user.first_name
    balances = load_balances()

    # Добавляем пользователя, если его еще нет
    if user_id not in balances:
        balances[user_id] = config.DEFAULT_BALANCE
        save_balances(balances)
        logger.info(f"New user registered: @{username} (ID: {user_id}) with {config.DEFAULT_BALANCE} coins.")

    await update.message.reply_text(
        f"👋 Привет, @{username}! Добро пожаловать!\n"
        "Я бот для управления игровой валютой и развлечений.\n\n"
        "ℹ️ **Команды:**\n"
        "/balans - Посмотреть свой баланс\n"
        "/transfer @user <сумма> - Перевести монеты другому пользователю (ответьте на его сообщение)\n"
        "/addbalans <сумма> - Пополнить баланс пользователю (только для админов, ответьте на сообщение пользователя)\n"
        "/casino - Меню казино\n"
        "/shop - Магазин предметов\n"
        "/help - Этот список команд"
    )

